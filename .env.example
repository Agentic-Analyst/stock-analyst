# vynn-core Configuration Template
# Copy this to .env and update with your actual values

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=your-database-name
# Configure the key for the selected model provider. OpenAI is the default;
# Anthropic is an alternative, not an additional requirement.
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=
# Optional richer news discovery; financial-model-only jobs do not use it.
SERPAPI_API_KEY=
SERPAPI_SEARCH_TIMEOUT_SECONDS=15     # bounded to 5..30s; do not let news search stall chat jobs

# Optional licensed analyst/market-data adapters. Auto prefers Benzinga, falls
# back to Finnhub and then Yahoo, and keeps every provider snapshot separate.
# TipRanks is disabled for durable reports under ordinary MCP terms; enable it
# only after receiving explicit storage and redistribution rights.
ANALYST_CONSENSUS_PROVIDER=auto       # auto | benzinga | finnhub | tipranks | none
ANALYST_CONSENSUS_MIN_ANALYSTS=5      # thinner snapshots remain visible but cannot drive publication policy
ANALYST_BENCHMARK_MAX_AGE_DAYS=180   # provider-dated evidence older than this cannot affect publication
BENZINGA_CONSENSUS_LOOKBACK_DAYS=365  # bounded by the worker to 30..730 days
BENZINGA_ANALYST_INSIGHTS_ENABLED=true # structured dated firm/rating/target metadata only; provider prose is ignored
BENZINGA_ANALYST_INSIGHTS_MAX_RECORDS=8 # latest-per-analyst rows retained; bounded to 1..25
BENZINGA_API_KEY=
FINNHUB_API_KEY=
ANALYST_CONSENSUS_SECONDARY=none      # none | tipranks
TIPRANKS_DURABLE_OUTPUTS_LICENSED=false
TIPRANKS_API_KEY=
TIPRANKS_MAX_CALLS_PER_WORKER=1       # locally bounded to 0..5; provider quota also applies
PEER_COMPS_ENABLED=false              # opt in with true after peer-quality/latency validation; auto is supported but not the safe default
PEER_COMPS_MAX_PEERS=10               # bounded to 10; >=3 valid observations required
PEER_COMPS_MIN_SIZE_RATIO=0.05        # exclude peers below 5% or above 20x subject market cap
PEER_COMPS_REQUEST_DELAY_SECONDS=1.05 # pace vendor requests to reduce account-wide rate-limit bursts
PEER_COMPS_MAX_OPERATING_MARGIN_GAP_PCT=15 # exclude business models with materially different margins
PEER_COMPS_MAX_REVENUE_GROWTH_GAP_PCT=20   # exclude peers in a materially different growth regime
PEER_COMPS_MAX_BANK_ROE_GAP_PCT=10          # bank peers must have comparable trailing ROE
NEWS_MAX_AGE_DAYS=90                  # source publication window; ingestion time never substitutes
NEWS_MIN_FRESH_ARTICLES=8             # thinner coverage is displayed but cannot move a rating
FINANCIAL_STATEMENT_MAX_AGE_DAYS=200  # annual-only fallback; hard-bounded to 90-240 days
QUARTERLY_STATEMENT_MAX_AGE_DAYS=150  # latest aligned quarter; hard-bounded to 90-180 days
ANALYSIS_MODEL_VERSION=dev            # immutable release id supplied by api-runner in production
OPENAI_GPT_4O_MINI_SNAPSHOT=gpt-4o-mini-2024-07-18
