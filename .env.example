# vynn-core Configuration Template
# Copy this to .env and update with your actual values

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=your-database-name
OPENAI_API_KEY=sk-xxx
SERPAPI_API_KEY=your-serpapi-key
ANTHROPIC_API_KEY=sk-ant-xxx

# Optional licensed analyst/market-data adapter. Price-target availability
# depends on your Finnhub plan. Credentials are sent in an auth header and are
# never written to reports. Broker account pages are intentionally not scraped.
ANALYST_CONSENSUS_PROVIDER=auto       # auto | finnhub | none
FINNHUB_API_KEY=
PEER_COMPS_ENABLED=false              # enable after validating provider coverage/rate limits
PEER_COMPS_MAX_PEERS=6                # bounded to 10; >=3 valid observations required
ANALYSIS_MODEL_VERSION=dev            # immutable release id supplied by api-runner in production
